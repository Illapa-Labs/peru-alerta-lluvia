{
  // El sitio en Cloudflare como archivos estáticos (la carpeta dist que deja `bun run build`), sin código en el
  // servidor: los datos los da la API de Illapa. Publicar: bun run build && npx wrangler deploy
  "name": "illapa-alerta-lluvia",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // Cada lugar tiene su dirección (/piura/piura/tambo-grande, ver src/rutas.ts): cualquier ruta que no sea un archivo
    // sirve la página, y la web muestra ese lugar
    "not_found_handling": "single-page-application"
  },
  // La dirección pública. Cloudflare crea el registro DNS y el certificado al desplegar.
  "routes": [{ "pattern": "alerta.illapalabs.org", "custom_domain": true }],
  "workers_dev": true,
  // Cada pull request recibe su propia vista previa (Workers Builds corre `wrangler preview`, que pide este bloque)
  "previews": {}
}
